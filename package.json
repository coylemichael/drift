{
  "name": "drift-pi",
  "version": "0.7.0",
  "private": true,
  "description": "Portable Drift workflows with Pi-owned lifecycle and artifact publication",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "pi": {
    "extensions": [
      "./extensions/drift.ts"
    ],
    "skills": [
      "./skills/drift/SKILL.md"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "files": [
    "skills/",
    "prompts/",
    "extensions/",
    "lib/",
    "scripts/_driftmeta.py",
    "scripts/build-index.py",
    "scripts/check-staleness.py",
    "README.md",
    "assets/"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "ruff check scripts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.3.36",
    "typescript": "^7.0.2"
  }
}
